# ---------------------------------------------------------------------------
# Social Media Privacy Risk Assessment Framework - example environment file
# Copy to ".env" and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# SQLite database location (privacy-minimised records only)
DATABASE_PATH=data/privacy_assessment.db

# Comma separated list of allowed CORS origins.
# For local development with the React dev server use:
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=*

# Simple in-memory API rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: key required by admin-style endpoints (authorisation concept)
ADMIN_API_KEY=change-me-local-only

# Optional: JSON file overriding the default Model-A category weights
PRIVACY_WEIGHTS_FILE=
